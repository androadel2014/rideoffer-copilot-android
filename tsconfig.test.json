  "include": ["src/engine/**/*.ts", "src/ocr/**/*.ts", "src/privacy/**/*.ts", "src/config/**/*.ts", "src/net/**/*.ts", "src/export/format.ts", "src/sync/payload.ts", "tests/**/*.ts"]
}
